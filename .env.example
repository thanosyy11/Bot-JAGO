# ============================================================
# Bot JAGO — Template Konfigurasi
# Salin file ini menjadi .env lalu isi nilainya
# cp .env.example .env
# ============================================================

# Token bot Telegram dari @BotFather
BOT_TOKEN=

# ID Telegram admin (dapatkan dari @userinfobot)
ADMIN_ID=

# Kunci enkripsi Fernet untuk keamanan password akun di database
# Generate dengan: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# PERINGATAN: Setelah ada data tersimpan, JANGAN ubah key ini!
#             Beda key = semua password akun tidak bisa terbaca.
ENCRYPTION_KEY=

# Mode Dry Run — jalankan seluruh alur (login, cart, nonce, update_order_review)
# tapi BERHENTI sebelum POST checkout final. Laporan detail dikirim ke Telegram.
# true  = aktifkan dry run (untuk pengujian pertama kali)
# false = war sesungguhnya (checkout dieksekusi)
DRY_RUN=true
